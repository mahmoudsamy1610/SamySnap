{
  "name": "samysnap",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension: record your screen, stream it to Google Drive, get the link instantly.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:all": "npm test && npm run test:e2e",
    "key": "node scripts/generate-key.mjs",
    "extension-id": "node scripts/generate-key.mjs --print",
    "icons": "python3 scripts/make-icons.py"
  },
  "engines": {
    "node": ">=20"
  }
}
